# Product / carla_scenarios machine defaults (tracked). Auto-loaded by cases/run_cases.
# This process is a CARLA Python *client*. UE is the *server*.
# UE same PC → 127.0.0.1. SIL/frame_ingest uses projects/<sku>/carla.env instead.

CARLA_HOST=100.98.153.2
#CARLA_HOST=127.0.0.1
CARLA_PORT=2000
GF_CARLA_CONNECT_TIMEOUT_S=10

# --- run_cases defaults (CLI overrides these when passed) ---
# GF_SCENARIO_DURATION_S  ==  --duration-s (most cases)
GF_SCENARIO_DURATION_S=8
# Tunnel / ISP enter+exit needs longer than the default 8s
GF_SCENARIO_DURATION_ISP_S=25
# GF_SCENARIO_STOP_ON_FAIL  ==  --stop-on-fail  (0 continue / 1 abort)
GF_SCENARIO_STOP_ON_FAIL=0
# Batch results report under results/runs/<ts>/ (1 on / 0 off)
GF_SCENARIO_WRITE_RESULTS=0
# GF_SCENARIO_DRY_RUN=1     ==  --dry-run
# GF_SCENARIO_VIEW_W=960
# GF_SCENARIO_VIEW_H=540

# Optional map load after connect (empty = keep whatever UE has).
# Independent of whether UE was started on that map.
GF_CARLA_TOWN=Town04

# Ambient Traffic Manager vehicles around the corridor (all cases).
# density 0=off 1=light(default) 2=medium 3=heavy. Batch does not wipe between cases.
GF_TRAFFIC_DENSITY=1
# GF_TRAFFIC_COUNT=12   # optional absolute override of density table

# ACC instrument SET (kph). TGT comes from planning ctrl; missing → "--"
GF_ACC_SET_KPH=50
# GF_ACC_TH_LO=1.0
# GF_ACC_TH_HI=2.5

# ChaseCam — pygame initial view (V / button still toggles at runtime)
#   1 = windshield (default)
#   2 = scene (chase)
ChaseCam=1

# Camera mount (extrinsics): ONLY from SKU compose camera_contract.json
# (gf-config → compose). Do not author GF_CAMERA_MOUNT_* numbers here.
# GF_PROJECT_DIR=../projects/oem_a/afc_no_uss
# GF_CAMERA_CONTRACT=../projects/oem_a/afc_no_uss/generated/camera_contract.json
GF_PROJECT_DIR=../projects/oem_a/afc_no_uss

# Weather knobs (cases/weather/*). Case script picks preset; these override fields.
# GF_SUN_ALTITUDE_DEG=70
# GF_SUN_AZIMUTH_DEG=45
# GF_SUN_BRIGHTNESS=1.0
# GF_RAIN_AMOUNT=80
# GF_RAIN_WETNESS=90
# GF_WIPER_SPEED=2
# GF_FOG_DENSITY=60
# GF_FOG_DISTANCE=15
# GF_WIND=40
