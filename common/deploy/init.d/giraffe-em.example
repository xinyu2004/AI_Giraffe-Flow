#!/bin/sh
# Giraffe EM — SysV init.d example (product entry = gf_em_daemon).
# Copy to /etc/init.d/giraffe-em, chmod +x, update-rc.d / chkconfig as needed.
# Edit RUNTIME below to the staged self-contained runtime root.

### BEGIN INIT INFO
# Provides:          giraffe-em
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Giraffe EM (gf_em_daemon)
### END INIT INFO

RUNTIME="${RUNTIME:-/opt/giraffe/current}"
DAEMON="${RUNTIME}/bin/gf_em_daemon"
PIDFILE="${PIDFILE:-/var/run/giraffe-em.pid}"
LOGDIR="${LOGDIR:-/var/log/giraffe/em}"
NAME=giraffe-em

export GF_BUILD_DIR="${RUNTIME}"
export GF_RUNTIME_DIR="${RUNTIME}"
export GF_IOX_TOML="${RUNTIME}/etc/iox_roudi.toml"
export GF_EM_LOG_DIR="${LOGDIR}"
export LD_LIBRARY_PATH="${RUNTIME}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# EM stops on abnormal child exit; init/systemd Restart recovers the whole tree.

start() {
  mkdir -p "${LOGDIR}"
  if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
    echo "${NAME} already running"
    return 0
  fi
  echo "Starting ${NAME}..."
  start-stop-daemon --start --background --make-pidfile --pidfile "${PIDFILE}" \
    --chdir "${RUNTIME}" --exec "${DAEMON}" -- \
    --build-dir "${RUNTIME}" --log-dir "${LOGDIR}" --deadline-ms 0 \
    || "${DAEMON}" --build-dir "${RUNTIME}" --log-dir "${LOGDIR}" --deadline-ms 0 &
  echo $! >"${PIDFILE}"
}

stop() {
  echo "Stopping ${NAME}..."
  if [ -f "${PIDFILE}" ]; then
    kill "$(cat "${PIDFILE}")" 2>/dev/null || true
    rm -f "${PIDFILE}"
  fi
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status)
    if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
      echo "${NAME} running pid=$(cat "${PIDFILE}")"
    else
      echo "${NAME} stopped"
      exit 3
    fi
    ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
