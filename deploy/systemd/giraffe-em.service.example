# Giraffe EM — single board unit (protection layer around gf_em_daemon).
# Copy to /etc/systemd/system/giraffe-em.service, edit paths, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now giraffe-em.service
#
# Contract matches SIL run_sil [EM]: start EM only.
# EM Spawns optional platform daemons (dlt?/RouDi?/…) + SOA apps from
# compose-frozen deploy_config.hpp (compiled into gf_em_daemon).
# generated/em_launch.yaml is human/diff only — not required at runtime.
#
# NOT in this unit: Foxglove tap, GMT inject, carla_bridge, DoIP — host/Flow tools.

[Unit]
Description=Giraffe Flow EM (gf_em_daemon)
After=network.target
Wants=network.target

[Service]
Type=simple
User=giraffe
Group=giraffe
WorkingDirectory=/opt/giraffe/current
Environment=GF_PLATFORM_DIR=/opt/giraffe/current/platform
Environment=GF_BUILD_DIR=/opt/giraffe/current/build
Environment=GF_IOX_TOML=/opt/giraffe/current/generated/iox_roudi.toml
Environment=GF_EM_LOG_DIR=/var/log/giraffe/em
Environment=LD_LIBRARY_PATH=/opt/giraffe/current/middleware/.deps-prefix/lib
ExecStart=/opt/giraffe/current/build/middleware/exec/gf_em_daemon --platform ${GF_PLATFORM_DIR} --build-dir ${GF_BUILD_DIR} --log-dir ${GF_EM_LOG_DIR} --deadline-ms 0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
