# SKU / SIL lab — copy to carla.env in THIS directory (gitignored).
# run_sil.sh auto-loads it when starting frame_ingest → carla_bridge.
# No enable_*.sh needed. Process env overrides any key.
#
# HIL: this machine is a CARLA Python *client* (tip writer).
#      CARLA UE on Windows is the *server*. carla_scenarios/carla.env is the
#      other client (scenario host) — do not copy its CARLA_HOST=127.0.0.1 here.
#
# CARLA_HOST = IP of the machine running CARLA UE (not this SIL box).

CARLA_HOST=100.98.153.2
CARLA_PORT=2000
GF_CARLA_WAIT_S=60
# Per RPC call timeout (remote UE often needs >5s under load).
GF_CARLA_CONNECT_TIMEOUT_S=10
# After drop / scenario hero respawn: reconnect|idle|exit (default reconnect).
GF_CARLA_BRIDGE_ON_FAIL=reconnect
GF_CARLA_RECONNECT_S=2
GF_CARLA_PYTHON=/home/herry/miniconda3/envs/carla_env/bin/python

# Perception tip camera (carla_bridge). Numbers only.
#   GF_CARLA_TIP_MOUNT  1 = windshield (default)
# Pose is vehicle-relative meters / degrees. Process env overrides these.
GF_CARLA_TIP_MOUNT=1
GF_CARLA_TIP_FOV=100
# GF_CARLA_TIP_X=0.55
# GF_CARLA_TIP_Y=0.0
# GF_CARLA_TIP_Z=1.35
# GF_CARLA_TIP_PITCH=-5
# GF_CARLA_TIP_YAW=0
# GF_CARLA_TIP_ROLL=0

# Scenario-machine pygame (carla_scenarios/carla.env) — not used by bridge:
# ChaseCam: 1=windshield  2=scene
