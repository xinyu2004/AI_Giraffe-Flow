# Ignore build & vendor artifacts (skeleton)

build/
build-*/
**/build-sil/
cmake-build-*/
out/
install/
.cache/
.deps-sysroot/
.deps-prefix/
middleware/.deps-prefix/
compile_commands.json

# Host Octave file IPC scratch (carla copy + repo)
**/octave_planning/_planio/
*.oct

# Vendored trees live under middleware/; keep policy in deps/
middleware/third_party/*/
!middleware/third_party/README.md
# Legacy root paths (pre-layout cleanup)
third_party/*/
!third_party/README.md

*.o
*.a
*.so
*.dylib
*.exe
*.pyc
__pycache__/
.venv/
venv/
100_dbc/

.idea/
.vscode/
*.user
.DS_Store

# Generated (when codegen lands)
**/generated/
!**/generated/.gitkeep
# Octave→C++ under planning app (gf-octavecoder; not gf-codegen)
**/apps/planning/**/oct_gen/
!**/apps/planning/**/oct_gen/.gitkeep

# Python tooling
**/__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# compose working outputs (golden/ is optional — produced after review; not shipped in demo by default)
projects/**/gf.sor.json
projects/**/golden/gf.sor.json
projects/**/reports/
*.yuv
!tools/**/fixtures/**/*.yuv

# Local IDE / agent
.cursor/
*.plan.md

# CMake user-local presets
CMakeUserPresets.json

# Python packaging
dist/
wheelhouse/
*.whl

# SIL / observability runtime when not under build/ (build/ already ignored)
observability/
**/iox_multiproc_logs/
**/runtime/logs/
**/runtime/collector/
**/runtime/per/
# PER dual-slot leftovers if run from repo root
*.kv.a
*.kv.b
*.kv.*.tmp
/dtc.kv.*

# Session captures outside build/ — GMT fixtures only
*.mcap
session*.jsonl
!tools/**/fixtures/session*.jsonl

# Architecture GIF generator (local helper)
gallery/_gen_architecture_gif.py

# FuSa local artifacts (do not commit)
fusa/runs/*
!fusa/runs/.gitkeep
fusa/packs/*
!fusa/packs/.gitkeep

# carla_scenarios batch results (keep README; ignore run outputs)
carla_scenarios/results/runs/*
!carla_scenarios/results/runs/.gitkeep
carla_scenarios/results/latest.json

# SKU-local CARLA endpoint overrides (carla_scenarios/carla.env is tracked)
projects/**/carla.env

# SIL file-IPC scratch (replay/file yuv only). Compose must not mkdir this for GfChannel.
**/runtime_ipc/
